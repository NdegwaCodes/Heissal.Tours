# ---------------------------------------------------------------------------
# Heissal Platform — environment template. Copy to `.env` and fill in.
# NEVER commit a real .env (it is gitignored).
# ---------------------------------------------------------------------------

# --- General ---
ENVIRONMENT=development                 # development | staging | production
PROJECT_NAME=Heissal Tours & Travel Platform
TIMEZONE=Africa/Nairobi
BASE_REPORTING_CURRENCY=USD             # internal margin reporting only

# --- API ---
API_V1_STR=/api/v1
# Comma-separated list of allowed CORS origins (admin/web/portal dev URLs)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Database (async SQLAlchemy / asyncpg) ---
POSTGRES_USER=heissal
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=heissal
POSTGRES_HOST=postgres                  # 'localhost' when running the API outside Docker
POSTGRES_PORT=5432
# Optional explicit override; if unset it is assembled from the parts above.
# DATABASE_URL=postgresql+asyncpg://heissal:change_me_in_env@postgres:5432/heissal
#
# Hosted Postgres (e.g. Neon) works too — paste the provider's URL as-is. The
# driver is normalised automatically (asyncpg at runtime, psycopg2 for Alembic)
# and libpq-only params (sslmode, channel_binding) are translated to an asyncpg
# TLS connection; pooler endpoints (PgBouncer) disable the statement cache.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# --- Redis (cache, refresh-token revocation, rate limiting) ---
REDIS_URL=redis://redis:6379/0

# --- Security / JWT ---
# Generate strong values, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=change_me_generate_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080      # 7 days

# --- Client portal (Stage 7.2) ---
# Where a client's own trip lives. The access token goes in the link's
# FRAGMENT (.../trip#<token>), which browsers never send to a server — so it
# stays out of access logs and Referer headers.
PORTAL_BASE_URL=http://localhost:3001
# How long after they travel a client can still open their trip. Not
# "until departure": the statement and the receipts are wanted afterwards, and
# a link that dies on the day they fly home is a support call.
PORTAL_ACCESS_DAYS_AFTER_TRAVEL=90

# --- First superuser (created by the seed on first run) ---
FIRST_SUPERUSER_EMAIL=admin@heissal.co.ke
FIRST_SUPERUSER_PASSWORD=ChangeMe123!
FIRST_SUPERUSER_NAME=Platform Admin

# --- Frontend (Next.js apps) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
