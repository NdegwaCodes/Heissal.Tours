# =========================================================================
# Heissal Platform monorepo .gitignore
# =========================================================================

# --- Env / secrets ---
.env
*.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
*.egg-info/
.venv/
venv/
ENV/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
*.sqlite
*.db

# --- Node / Next.js / Turbo ---
node_modules/
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Logs ---
*.log
logs/

# --- IDE / OS ---
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
