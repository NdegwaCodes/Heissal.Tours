# =========================================================================
# Heissal Platform monorepo .gitignore
# =========================================================================

# --- Env / secrets ---
.env
*.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
*.egg-info/
.venv/
venv/
ENV/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
*.sqlite
*.db

# --- Node / Next.js / Turbo ---
node_modules/
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Logs ---
*.log
logs/

# --- IDE / OS ---
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db

# --- Git bundles (delivery artifacts; commits already live in history) ---
*.bundle

# Uploaded files (supplier rate sheets, property images). Bytes live on disk and
# only their metadata goes in Postgres. Supplier contract rates are confidential
# and must never enter git history.
apps/api/var/
var/uploads/

# Filled-in rate intake workbooks. The blank template and its guide are tracked;
# anything an agent has actually typed supplier rates into is confidential and
# must never enter git history — same rule as the uploaded sheets above.
docs/templates/rate-intake/*.xlsx
docs/templates/rate-intake/*.xls
docs/templates/rate-intake/filled/
